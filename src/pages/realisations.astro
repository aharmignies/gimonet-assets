---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Appartement Haussmannien',
    category: 'Peinture Intérieure',
    cat: 'peinture',
    desc: 'Finition mate velours et rechampis soignés.',
    height: 'tall',
    accent: '#8b1a1a',
  },
  {
    title: 'Parquet Point de Hongrie',
    category: 'Revêtements de Sol',
    cat: 'sols',
    desc: 'Chêne massif verni, pose traditionnelle.',
    height: 'short',
    accent: '#a87c4f',
  },
  {
    title: 'Showroom Design',
    category: 'Sol Résine',
    cat: 'sols',
    desc: 'Revêtement autolissant haute résistance.',
    height: 'tall',
    accent: '#d7d3cc',
  },
  {
    title: 'Villa Contemporaine',
    category: 'Peinture Décorative',
    cat: 'peinture',
    desc: "Badigeon de chaux et finitions à l'ancienne.",
    height: 'short',
    accent: '#e8dcc4',
  },
  {
    title: 'Espace Coworking',
    category: 'Sols Souples',
    cat: 'sols',
    desc: 'Lames LVT imitation chêne naturel.',
    height: 'short',
    accent: '#665e4b',
  },
  {
    title: 'Ravalement de Façade',
    category: 'Peinture Extérieure',
    cat: 'peinture',
    desc: "Traitement d'imperméabilisation et lasure.",
    height: 'tall',
    accent: '#f0e8df',
  },
];
---

<Layout title="Réalisations — Hermelin Jouzeau Peinture & Sol">
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Nos Réalisations</h1>
      <p class="lead">
        Découvrez l'excellence de notre savoir-faire à travers une sélection
        de projets résidentiels et tertiaires. Chaque réalisation témoigne
        de notre engagement pour la précision et l'élégance.
      </p>

      <div class="filters" role="tablist" aria-label="Filtrer les projets">
        <button class="filter active" data-filter="all" role="tab" aria-selected="true">Tous</button>
        <button class="filter" data-filter="peinture" role="tab" aria-selected="false">Peinture</button>
        <button class="filter" data-filter="sols" role="tab" aria-selected="false">Sols</button>
      </div>
    </div>
  </section>

  <!-- Masonry gallery -->
  <section class="section">
    <div class="container">
      <div class="masonry">
        {projects.map((p) => (
          <figure class={`project project-${p.height}`} data-cat={p.cat}>
            <div class="project-image" style={`background-color: ${p.accent};`} role="img" aria-label={p.title}>
              <span class="material-symbols-outlined">image</span>
            </div>
            <figcaption>
              <span class="project-category">{p.category}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Étude de cas / featured -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Étude de cas</span>
        <h2>L'Art de la Transformation</h2>
        <p>
          Explorez l'impact de notre travail à travers un chantier emblématique
          de rénovation complète.
        </p>
      </div>

      <div class="case-study">
        <div class="case-visual" aria-hidden="true">
          <div class="case-visual-half before">
            <span class="case-label">Avant</span>
            <span class="material-symbols-outlined">image</span>
          </div>
          <div class="case-visual-half after">
            <span class="case-label">Après</span>
            <span class="material-symbols-outlined">image</span>
          </div>
        </div>
        <div class="case-text">
          <span class="eyebrow">Étude de cas : Résidence « Le Parc »</span>
          <h3>Rénovation complète d'un espace de vie de 120 m²</h3>
          <p>
            Pour ce projet d'envergure, nous avons procédé à une remise à
            nu totale des supports. Le défi résidait dans l'alliance entre
            conservation de l'ancien et apport d'une modernité épurée.
          </p>
          <ul class="case-steps">
            <li>
              <span class="material-symbols-outlined">check_circle</span>
              <div>
                <strong>Dépose et ponçage</strong>
                <span>Retrait de 3 couches de moquette et ponçage intensif.</span>
              </div>
            </li>
            <li>
              <span class="material-symbols-outlined">check_circle</span>
              <div>
                <strong>Préparation des supports</strong>
                <span>Enduisage complet et pose de toile de rénovation.</span>
              </div>
            </li>
            <li>
              <span class="material-symbols-outlined">check_circle</span>
              <div>
                <strong>Finition signature</strong>
                <span>Peinture à l'huile mate et vitrification haute résistance.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="cta-banner">
    <div class="container cta-inner">
      <h2>Votre projet mérite l'excellence.</h2>
      <p>
        Confiez vos envies de décoration et de rénovation à une entreprise
        familiale qui place la qualité au cœur de chaque geste.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">Demander un devis personnalisé</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    line-height: 1;
  }

  /* Page hero */
  .page-hero {
    padding: clamp(3rem, 7vw, 5rem) 0 2rem;
  }
  .page-hero h1 { max-width: 800px; margin-bottom: 1rem; }
  .page-hero .lead { max-width: 720px; margin-bottom: 2.5rem; }

  /* Filters */
  .filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .filter {
    padding: 0.6rem 1.5rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all var(--transition);
  }
  .filter:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .filter.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  /* Masonry gallery using CSS grid */
  .masonry {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 240px;
    gap: 1.5rem;
  }
  .project {
    margin: 0;
    background: #fff;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-light);
    transition: all var(--transition);
    display: flex;
    flex-direction: column;
  }
  .project-tall { grid-row: span 2; }
  .project-short { grid-row: span 1; }
  .project:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-ambient);
  }
  .project.hidden { display: none; }

  .project-image {
    flex: 1 1 auto;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .project-image .material-symbols-outlined {
    font-size: 2.5rem !important;
    color: rgba(255, 255, 255, 0.45);
  }
  .project figcaption {
    padding: 1.1rem 1.25rem 1.25rem;
    background: #fff;
  }
  .project-category {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }
  .project h3 { font-size: 1rem; margin-bottom: 0.25rem; }
  .project p {
    color: var(--color-text-light);
    font-size: 0.85rem;
    margin: 0;
  }

  /* Case study split layout */
  .case-study {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .case-visual {
    aspect-ratio: 4 / 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    background: var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .case-visual-half {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .case-visual-half.before { background: var(--color-border); }
  .case-visual-half.after { background: var(--color-accent); }
  .case-visual-half .material-symbols-outlined {
    font-size: 2rem !important;
    color: var(--color-text-light);
    opacity: 0.5;
  }
  .case-label {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(26, 26, 26, 0.75);
    color: #fff;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
  }
  .case-text h3 {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    margin-bottom: 1rem;
  }
  .case-steps {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .case-steps li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .case-steps .material-symbols-outlined {
    font-size: 1.5rem !important;
    color: var(--color-primary);
    flex-shrink: 0;
  }
  .case-steps strong {
    display: block;
    color: var(--color-dark);
    margin-bottom: 0.15rem;
  }
  .case-steps span {
    color: var(--color-text-light);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .masonry {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 200px;
    }
    .case-study { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .masonry {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .project-tall, .project-short { grid-row: span 1; }
    .project-image { min-height: 200px; }
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
  const projects = document.querySelectorAll<HTMLElement>('.project');

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      filters.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const target = btn.dataset.filter;
      projects.forEach((p) => {
        const show = target === 'all' || p.dataset.cat === target;
        p.classList.toggle('hidden', !show);
      });
    });
  });
</script>
