---
import Layout from '../layouts/Layout.astro';

const services = [
  { icon: 'brush', title: 'Peinture intérieure', desc: 'Murs, plafonds, boiseries. Préparation, enduit, peinture acrylique ou glycéro, finitions mat, satin ou velours.' },
  { icon: 'format_paint', title: 'Peinture extérieure', desc: 'Façades, volets, portails, clôtures. Traitement préalable, peinture résistante UV et intempéries.' },
  { icon: 'grid_view', title: 'Pose de parquet', desc: 'Parquet massif ou contrecollé, pose clouée, collée ou flottante. Ponçage et vitrification possibles.' },
  { icon: 'layers', title: 'Pose de stratifié', desc: 'Stratifiés haut de gamme, pose flottante rapide et propre. Large choix de finitions bois ou pierre.' },
  { icon: 'texture', title: 'Revêtements souples', desc: 'Vinyle, lino, PVC. Idéal cuisine, salle de bain, locaux professionnels. Pose collée étanche.' },
  { icon: 'palette', title: 'Conseil couleur', desc: 'Étude colorimétrique personnalisée, harmonisation des teintes, sélection des matériaux adaptés.' },
];

const steps = [
  { num: '01', title: 'Devis', desc: 'Analyse sur site, conseil technique et chiffrage précis sous 48h.' },
  { num: '02', title: 'Préparation', desc: 'Protection des surfaces et préparation minutieuse des supports.' },
  { num: '03', title: 'Réalisation', desc: 'Mise en œuvre par nos artisans qualifiés selon les règles de l\'art.' },
  { num: '04', title: 'Livraison', desc: 'Nettoyage complet et validation conjointe du résultat final.' },
];
---

<Layout title="Nos services — Hermelin Jouzeau Peinture & Sol">
  <!-- Hero éditorial -->
  <section class="services-hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <span class="eyebrow">Savoir-faire artisanal</span>
        <h1>L'excellence du geste pour vos intérieurs.</h1>
        <p class="lead">
          De la peinture décorative à la pose de sols techniques, nous
          accompagnons vos projets de rénovation avec une rigueur familiale
          et une précision haut de gamme.
        </p>
      </div>
      <div class="hero-image" aria-hidden="true">
        <div class="hero-image-inner">
          <span class="material-symbols-outlined">brush</span>
          <span class="hero-image-label">Photographie artisan à intégrer</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Nos prestations -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="prestations-title">
        <span class="eyebrow">Nos Prestations</span>
        <span class="prestations-underline"></span>
      </h2>
      <div class="services-grid">
        {services.map((s) => (
          <article class="service-card">
            <span class="material-symbols-outlined service-icon">{s.icon}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <a href="/contact" class="link-more">En savoir plus →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Notre processus -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>Notre Processus</h2>
        <p>Une approche claire et professionnelle, du premier contact à la remise des clés.</p>
      </div>
      <ol class="process-grid">
        {steps.map((step) => (
          <li class="process-step">
            <span class="step-num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="cta-banner">
    <div class="container cta-inner">
      <h2>Prêt à transformer votre espace ?</h2>
      <p>Basés en région nantaise, nous intervenons sur tous types de projets résidentiels et tertiaires. Discutons de votre vision dès aujourd'hui.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">Demander mon devis</a>
        <a href="/realisations" class="btn btn-outline">Voir nos réalisations</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    line-height: 1;
  }

  /* Hero éditorial split */
  .services-hero {
    padding: clamp(3rem, 6vw, 5rem) 0;
    background: var(--color-surface);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .hero-text .lead {
    max-width: 560px;
    margin-top: 1.5rem;
  }
  .hero-image {
    aspect-ratio: 4 / 3;
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-image-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-light);
  }
  .hero-image-inner .material-symbols-outlined {
    font-size: 3rem;
    color: var(--color-primary);
    opacity: 0.6;
  }
  .hero-image-label {
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  /* Titre de section avec barre */
  .prestations-title {
    margin-bottom: 3rem;
  }
  .prestations-title .eyebrow {
    display: block;
    color: var(--color-dark);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    text-transform: none;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }
  .prestations-underline {
    display: block;
    width: 60px;
    height: 3px;
    background: var(--color-primary);
  }

  /* Services grid (6 cards) */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .service-card {
    background: #fff;
    padding: 2.5rem 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    transition: all var(--transition);
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-ambient);
    border-color: var(--color-primary-soft);
  }
  .service-icon {
    font-size: 2.25rem !important;
    color: var(--color-primary);
    margin-bottom: 1rem;
    display: block;
  }
  .service-card h3 { margin-bottom: 0.75rem; }
  .service-card p {
    color: var(--color-text);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }
  .link-more {
    display: inline-block;
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Process timeline horizontal */
  .process-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    counter-reset: step;
  }
  .process-step {
    position: relative;
    padding: 2rem 1.5rem;
    background: #fff;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-light);
  }
  .step-num {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .process-step h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .process-step p {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin: 0;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
